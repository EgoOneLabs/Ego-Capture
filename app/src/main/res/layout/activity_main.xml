<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/ego_page_background"
    android:padding="12dp" android:focusableInTouchMode="true">
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ego Capture" android:textSize="23sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ego_text" />
        <Button android:id="@+id/languageButton" android:layout_width="88dp" android:layout_height="40dp" android:minHeight="40dp" android:text="English" style="@style/EgoButton" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/ego_card" android:padding="12dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <!-- Native sink remains alive at 1dp. Only the two-eye Canvas view is visible. -->
            <com.egouvc.phone.camera.StereoPreviewSurface android:id="@+id/previewSurface" android:layout_width="1dp" android:layout_height="1dp" android:importantForAccessibility="no" />
            <com.egouvc.phone.camera.StereoPreviewView android:id="@+id/decodedPreviewImage" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ego_surface" android:contentDescription="@string/onepage_preview_description" />
            <TextView android:id="@+id/previewHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="8dp" android:text="@string/onepage_connect_hint" style="@style/EgoCaption" android:background="#E6FFFFFF" android:importantForAccessibility="yes" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/ego_card">
        <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="@string/ui_session" android:tag="text:ui_session" android:textSize="16sp" android:fontFamily="sans-serif-medium" style="@style/EgoBody" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="22dp" android:text="@string/ui_task_label" android:tag="text:ui_task_label" android:labelFor="@id/taskNameInput" style="@style/EgoCaption" />
                <EditText android:id="@+id/taskNameInput" android:layout_width="match_parent" android:layout_height="44dp" android:minHeight="44dp" android:padding="10dp" android:textSize="14sp" android:hint="task001" android:singleLine="true" android:inputType="text" android:imeOptions="actionNext" android:maxLength="80" style="@style/EgoInput" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="22dp" android:text="@string/ui_device_label" android:tag="text:ui_device_label" android:labelFor="@id/exportDeviceInput" style="@style/EgoCaption" />
                <EditText android:id="@+id/exportDeviceInput" android:layout_width="match_parent" android:layout_height="44dp" android:minHeight="44dp" android:padding="10dp" android:textSize="14sp" android:hint="2UQ2" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" android:maxLength="80" style="@style/EgoInput" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/onepage_fps" android:tag="text:onepage_fps" style="@style/EgoCaption" />
            <Spinner android:id="@+id/savedFpsSpinner" android:layout_width="132dp" android:layout_height="44dp" android:background="@drawable/ego_input" android:paddingStart="8dp" android:paddingEnd="8dp" android:spinnerMode="dropdown" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginTop="12dp">
        <Button android:id="@+id/startCaptureButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:enabled="false" android:text="@string/capture_text_7" android:tag="text:capture_text_7" android:minHeight="48dp" style="@style/EgoPrimaryButton" />
        <Button android:id="@+id/stopCaptureButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:enabled="false" android:text="@string/capture_text_8" android:tag="text:capture_text_8" android:minHeight="48dp" style="@style/EgoStopButton" />
    </LinearLayout>
    <LinearLayout android:id="@+id/outputGroup" android:layout_width="match_parent" android:layout_height="100dp" android:orientation="vertical" android:layout_marginTop="10dp" android:background="@drawable/ego_card" android:padding="10dp">
        <TextView android:layout_width="match_parent" android:layout_height="18dp" android:text="@string/onepage_output" android:tag="text:onepage_output" style="@style/EgoCaption" />
        <TextView android:id="@+id/outputPath" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="@color/ego_text" android:textSize="11sp" android:includeFontPadding="false" android:lineSpacingExtra="1dp" android:textIsSelectable="true" android:importantForAccessibility="yes" />
    </LinearLayout>
</LinearLayout>
