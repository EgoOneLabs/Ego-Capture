<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ego_canvas">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="108dp" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="20dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="0dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_brand" android:tag="text:ui_brand" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02" style="@style/EgoBody" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_subtitle" android:tag="text:ui_subtitle" android:layout_marginTop="5dp" style="@style/EgoCaption" />
                </LinearLayout>
                <Button android:id="@+id/languageButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="English" android:minHeight="48dp" android:minWidth="76dp" style="@style/EgoButton" />
            </LinearLayout>
            <LinearLayout style="@style/EgoCard">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_connection" android:tag="text:ui_connection" style="@style/EgoHeading" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/connectionValue" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/state_disconnected" android:tag="text:state_disconnected" android:layout_weight="1" android:layout_marginEnd="8dp" android:padding="10dp" android:minHeight="40dp" android:gravity="center_vertical" style="@style/EgoBody" android:textSize="13sp" />
                    <TextView android:id="@+id/cameraStateValue" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/video_idle" android:tag="text:video_idle" android:layout_weight="1" android:layout_marginEnd="0dp" android:padding="10dp" android:minHeight="40dp" android:gravity="center_vertical" style="@style/EgoBody" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:id="@+id/cameraMessageValue" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/EgoBody" android:textSize="14sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/messageValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" style="@style/EgoBody" android:textSize="14sp" android:textColor="@color/ego_stop" android:layout_marginTop="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
                    <Button android:id="@+id/refreshButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/refresh_devices" android:tag="text:refresh_devices" android:layout_marginEnd="8dp" style="@style/EgoButton" />
                    <Button android:id="@+id/requestPermissionButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="@string/request_permission" android:tag="text:request_permission" style="@style/EgoButton" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/EgoCard">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_preview" android:tag="text:ui_preview" style="@style/EgoHeading" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/ego_preview" android:clipToOutline="true">
                    <!-- Keep UVC's Surface alive, but only the sampled ImageView is visible.
                         Do not use GONE/INVISIBLE: surfaceDestroyed would close the camera. -->
                    <com.egouvc.phone.camera.StereoPreviewSurface android:id="@+id/previewSurface" android:layout_width="1dp" android:layout_height="1dp" android:importantForAccessibility="no" />
                    <com.egouvc.phone.camera.MeasuredPreviewImage android:id="@+id/decodedPreviewImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:scaleType="fitCenter" android:background="#FF000000" android:contentDescription="Decoded USB stereo camera preview" />
                </FrameLayout>
                <TextView android:id="@+id/previewFpsValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_preview_waiting" android:tag="text:ui_preview_waiting" style="@style/EgoBody" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
                    <Button android:id="@+id/openCameraButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="@string/open_camera" android:tag="text:open_camera" android:layout_marginEnd="8dp" style="@style/EgoButton" />
                    <Button android:id="@+id/closeCameraButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="@string/close_camera" android:tag="text:close_camera" style="@style/EgoButton" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/EgoCard">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_session" android:tag="text:ui_session" style="@style/EgoHeading" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_task_label" android:tag="text:ui_task_label" android:layout_marginTop="16dp" style="@style/EgoCaption" />
                <EditText android:id="@+id/taskNameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/capture_text_3" android:inputType="text" android:singleLine="true" android:maxLength="80" android:tag="hint:capture_text_3" style="@style/EgoInput" android:layout_marginTop="7dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_device_label" android:tag="text:ui_device_label" android:layout_marginTop="14dp" style="@style/EgoCaption" />
                <EditText android:id="@+id/exportDeviceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/capture_text_4" android:inputType="text" android:singleLine="true" android:maxLength="80" android:tag="hint:capture_text_4" style="@style/EgoInput" android:layout_marginTop="7dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_frame_rate" android:tag="text:ui_frame_rate" android:layout_marginTop="14dp" style="@style/EgoCaption" />
                <Spinner android:id="@+id/savedFpsSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/ego_input" android:paddingStart="12dp" android:paddingEnd="12dp" style="@style/EgoBody" android:layout_marginTop="7dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_9" android:id="@+id/savedFpsHint" android:tag="text:capture_text_9" style="@style/EgoBody" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_capture_hint" android:tag="text:ui_capture_hint" android:layout_marginTop="10dp" style="@style/EgoCaption" />
            </LinearLayout>
            <LinearLayout style="@style/EgoCard">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_recording" android:tag="text:ui_recording" style="@style/EgoHeading" />
                <TextView android:id="@+id/storageRateValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_11" android:tag="text:capture_text_11" android:fontFamily="sans-serif-medium" style="@style/EgoBody" android:textSize="15sp" android:layout_marginTop="14dp" />
                <TextView android:id="@+id/audioStatusValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_status_initial" android:tag="text:audio_status_initial" style="@style/EgoBody" android:textSize="14sp" android:textColor="@color/ego_muted" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/recordingStatusValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_12" android:textIsSelectable="true" android:tag="text:capture_text_12" android:maxLines="4" android:ellipsize="end" style="@style/EgoBody" android:textSize="14sp" android:textColor="@color/ego_text" android:layout_marginTop="12dp" />
                <Button android:id="@+id/recordingDetailsToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_expand_status" android:tag="text:ui_expand_status" style="@style/EgoButton" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_data_scope" android:tag="text:ui_data_scope" android:layout_marginTop="12dp" style="@style/EgoCaption" />
            </LinearLayout>
            <LinearLayout style="@style/EgoCard">
                <Button android:id="@+id/diagnosticsToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_17" android:tag="text:capture_text_17" style="@style/EgoButton" />
                <LinearLayout android:id="@+id/diagnosticsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" style="@style/EgoBody">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_18" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:capture_text_18" style="@style/EgoCaption" />
                    <TextView android:id="@+id/deviceNameValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:not_available" style="@style/EgoBody" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_19" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:capture_text_19" style="@style/EgoCaption" />
                    <TextView android:id="@+id/vidPidValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:not_available" style="@style/EgoBody" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_20" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:capture_text_20" style="@style/EgoCaption" />
                    <TextView android:id="@+id/hostValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:not_available" style="@style/EgoBody" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_21" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:capture_text_21" style="@style/EgoCaption" />
                    <TextView android:id="@+id/cameraPermissionValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_granted" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:not_granted" style="@style/EgoBody" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_22" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:capture_text_22" style="@style/EgoCaption" />
                    <TextView android:id="@+id/usbPermissionValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_target_device" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:no_target_device" style="@style/EgoBody" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_23" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:capture_text_23" style="@style/EgoCaption" />
                    <TextView android:id="@+id/cameraModeValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:not_available" style="@style/EgoBody" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_24" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:capture_text_24" style="@style/EgoCaption" />
                    <TextView android:id="@+id/cameraFpsValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/video_fps_waiting" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:video_fps_waiting" style="@style/EgoBody" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_27" android:textSize="13sp" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:capture_text_27" style="@style/EgoCaption" />
                    <TextView android:id="@+id/cameraModesValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" android:textColor="@color/ego_muted" android:layout_marginTop="10dp" android:tag="text:not_available" style="@style/EgoBody" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_imu_probe" android:tag="text:ui_imu_probe" android:layout_marginTop="18dp" style="@style/EgoHeading" />
                    <TextView android:id="@+id/imuProbeValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_14" android:textIsSelectable="true" android:tag="text:capture_text_14" style="@style/EgoBody" android:textSize="14sp" android:layout_marginTop="10dp" />
                    <Button android:id="@+id/probeImuButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="@string/capture_text_15" android:tag="text:capture_text_15" style="@style/EgoButton" android:layout_marginTop="10dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capture_text_16" android:tag="text:capture_text_16" android:layout_marginTop="10dp" style="@style/EgoCaption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="18dp" android:background="@color/ego_surface" android:elevation="8dp">
        <Button android:id="@+id/startCaptureButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="@string/capture_text_7" android:tag="text:capture_text_7" android:layout_marginEnd="10dp" style="@style/EgoPrimaryButton" />
        <Button android:id="@+id/stopCaptureButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="@string/capture_text_8" android:tag="text:capture_text_8" style="@style/EgoStopButton" />
    </LinearLayout>
</FrameLayout>