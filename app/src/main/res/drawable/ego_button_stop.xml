<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#32FFFFFF">
    <item><selector>
        <item android:state_enabled="false"><shape><solid android:color="#80DEE7F0" /><corners android:radius="15dp" /><stroke android:width="1dp" android:color="#B3FFFFFF" /></shape></item>
        <item android:state_pressed="true"><shape><solid android:color="#FFD9DD" /><corners android:radius="15dp" /></shape></item>
        <item><shape><gradient android:angle="270" android:startColor="#E6FFFFFF" android:endColor="#C2FFE8EA" /><corners android:radius="15dp" /><stroke android:width="1dp" android:color="#80FFFFFF" /></shape></item>
    </selector></item>
</ripple>
