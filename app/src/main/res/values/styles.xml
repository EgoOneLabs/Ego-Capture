<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EgoUVCPhone" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/ego_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/ego_canvas</item>
        <item name="android:navigationBarColor">@color/ego_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/ego_canvas</item>
        <item name="android:textColorPrimary">@color/ego_text</item>
        <item name="android:textColorSecondary">@color/ego_muted</item>
        <item name="android:buttonStyle">@style/EgoButton</item>
        <item name="android:textViewStyle">@style/EgoBody</item>
        <item name="android:editTextStyle">@style/EgoInput</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="EgoBody" parent="android:style/Widget.Material.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ego_text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="EgoCaption" parent="EgoBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ego_muted</item>
    </style>
    <style name="EgoHeading" parent="EgoBody">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="EgoButton" parent="android:style/Widget.Material.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/ego_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textColor">@color/ego_button_text</item>
    </style>
    <style name="EgoPrimaryButton" parent="EgoButton">
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/ego_button_primary</item>
        <item name="android:textColor">@color/ego_primary_text</item>
    </style>
    <style name="EgoStopButton" parent="EgoButton">
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/ego_button_stop</item>
        <item name="android:textColor">@color/ego_stop_text</item>
    </style>
    <style name="EgoInput" parent="android:style/Widget.Material.EditText">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ego_text</item>
        <item name="android:textColorHint">@color/ego_muted</item>
        <item name="android:background">@drawable/ego_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="EgoCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/ego_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
